{
  "name": "av-manager",
  "version": "1.0.4",
  "private": true,
  "description": "本地私人影片库管理器：扫描、元数据抓取、流式播放、Elo 对战评分",
  "author": "1998SUIYUE",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sb": "next build && next start",
    "clean": "rimraf .next",
    "pack:standalone": "node scripts/prepare-standalone.js",
    "electron:dev": "electron .",
    "dist": "next build && npm run pack:standalone && electron-builder --win",
    "prune:remote-covers": "node scripts/prune-remote-cover-urls.js",
    "prune:invalid-cover-metadata": "node scripts/prune-invalid-cover-metadata.js",
    "prune:invalid-cover-metadata:apply": "node scripts/prune-invalid-cover-metadata.js --apply"
  },
  "dependencies": {
    "axios": "^1.7.8",
    "cheerio": "^1.1.0",
    "https-proxy-agent": "^7.0.6",
    "next": "^15.0.3",
    "playwright": "^1.54.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-jsx": "^5.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "jest": "^30.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.suiyue.avmanager",
    "productName": "AV Manager",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "standalone-packaged",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AV Manager"
    }
  }
}
